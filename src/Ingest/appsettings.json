{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Ingest": {
    "DataDir": "data",
    "PollInterval": "00:00:05",
    "StaticCheckInterval": "06:00:00",
    "Realtime": [
      { "Name": "metro-vehicles", "Url": "https://svc.metrotransit.org/mtgtfs/vehiclepositions.pb" },
      { "Name": "metro-tripupdates", "Url": "https://svc.metrotransit.org/mtgtfs/tripupdates.pb" },
      { "Name": "metro-alerts", "Url": "https://svc.metrotransit.org/mtgtfs/alerts.pb" }
    ],
    "Static": [
      { "Name": "metro-gtfs", "Url": "https://svc.metrotransit.org/mtgtfs/gtfs.zip" },
      { "Name": "metro-gtfs-next", "Url": "https://svc.metrotransit.org/mtgtfs/next/gtfs.zip" }
    ]
  }
}
